{
  "name": "outscope",
  "displayName": "Outscope",
  "description": "Outscope safely escapes nested JavaScript, TypeScript, JSX, and TSX closing syntax with one command.",
  "version": "2.0.3",
  "publisher": "local",
  "icon": "public/Logo_Marekt.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "javascript",
    "typescript",
    "jsx",
    "tsx",
    "cursor"
  ],
  "activationEvents": [
    "onCommand:outscope.escape"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "outscope.escape",
        "title": "Smart Syntax Escape",
        "category": "Outscope"
      }
    ],
    "keybindings": [
      {
        "command": "outscope.escape",
        "key": "alt+enter",
        "when": "editorTextFocus && (editorLangId == javascript || editorLangId == javascriptreact || editorLangId == typescript || editorLangId == typescriptreact)"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test out/test/smartEscape.test.js",
    "package": "npm run compile && vsce package --allow-missing-repository"
  },
  "dependencies": {
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.0"
  }
}
