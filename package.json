{
  "name": "outscope",
  "displayName": "Outscope",
  "description": "Smartly escape nested syntax with a single keystroke.",
  "version": "1.0.0",
  "publisher": "Outscope-dev",
  "icon": "public/Logo.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Outscope-dev/Outscope"
  },
  "homepage": "https://github.com/Outscope-dev/Outscope#readme",
  "bugs": {
    "url": "https://github.com/Outscope-dev/Outscope/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "javascript",
    "typescript",
    "jsx",
    "tsx",
    "cursor"
  ],
  "activationEvents": [
    "onCommand:outscope.escape"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "outscope.escape",
        "title": "Smart Syntax Escape",
        "category": "Outscope"
      }
    ],
    "keybindings": [
      {
        "command": "outscope.escape",
        "key": "alt+enter",
        "when": "editorTextFocus && (editorLangId == javascript || editorLangId == javascriptreact || editorLangId == typescript || editorLangId == typescriptreact)"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test out/test/smartEscape.test.js",
    "package": "npm run compile && vsce package"
  },
  "dependencies": {
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.0"
  }
}
